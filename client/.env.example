# Base URL of the API, without a trailing slash. Read by Vite at build/dev start: restart `npm run dev` after editing .env.
# Everything prefixed VITE_ is bundled into the browser code and is PUBLIC, so never put a secret here.
VITE_API_URL=http://localhost:4000
# Netlify: set VITE_API_URL in the site's environment variables (the deployed API's address, no trailing slash). It is baked into
# the JavaScript when the site is BUILT, so changing it needs a new deploy, not a restart.
