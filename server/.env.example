PORT=4000
# Production (Render): set the variables below in the dashboard, never in a committed file. DATABASE_URL is then the Neon
# DIRECT (not pooled) connection string with sslmode=require. See "Deploying" in the README.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking
# Used only by `npm test` and `npm run test:db:migrate`. The database name MUST end in "_test":
# tests empty every table, and both commands refuse to run against any other name.
TEST_DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_test
SEED_ADMIN_PASSWORD=change-me-admin
SEED_USER_PASSWORD=change-me-user
# Min 32 chars; values starting with "change-me" are rejected at startup.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-random-secret-of-32-plus-chars
JWT_EXPIRES_IN=1h
# In production this must be at least 10 (the server refuses to start otherwise). Free hosting has little CPU, so start at 10.
BCRYPT_COST=12
# Browser origins allowed to call the API (CORS), comma-separated. Each must be exactly scheme://host[:port]:
# no "*", no path, no trailing slash. Default is the Vite dev server. In production, set it to the deployed front end.
# REQUIRED in production (set NODE_ENV=production and NODE_VERSION=24 in the Render dashboard too). If it is left out, the server
# silently uses this development value and every browser request from the real site is blocked.
CORS_ORIGINS=http://localhost:5173
